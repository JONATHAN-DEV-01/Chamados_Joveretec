# ---------------------------------------------------------------
# Backend (Quarkus) — copie para .env e preencha.
# Em dev/test os valores abaixo são opcionais: o Quarkus sobe um
# PostgreSQL via Dev Services e gera chaves JWT temporárias.
# ---------------------------------------------------------------

# Banco (Supabase em produção)
DB_URL=jdbc:postgresql://localhost:5432/chamados
DB_USER=postgres
DB_PASSWORD=troque-me

# JWT
JWT_ISSUER=https://chamados.joveretec.com.br
JWT_DURACAO_MINUTOS=480
# Chaves RSA em PEM (obrigatórias em prod). Conteúdo completo, incluindo BEGIN/END.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# CORS: origens permitidas, separadas por vírgula
CORS_ORIGINS=http://localhost:4200

# Admin inicial (criado na primeira subida se não existir nenhum admin)
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@joveretec.com.br
ADMIN_SENHA=troque-me-123

# Porta HTTP (o Render define automaticamente)
PORT=8080

# Anexos: "local" (disco do servidor, dev/test) ou "supabase" (padrão em produção)
ARMAZENAMENTO_TIPO=supabase
# Supabase Storage (Project Settings → API / API Keys)
SUPABASE_URL=https://seu-projeto.supabase.co
# Chave SECRETA (service_role ou sb_secret_...). Só no backend: NUNCA na Vercel/frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Chave PÚBLICA (anon ou sb_publishable_...): enviada ao navegador no upload TUS assinado.
SUPABASE_ANON_KEY=
# Bucket privado dos anexos
STORAGE_BUCKET=chamados-anexos
# Só com ARMAZENAMENTO_TIPO=local (opcional): pasta onde os arquivos são gravados
# ARMAZENAMENTO_LOCAL_DIRETORIO=/tmp/chamados-anexos

# ---------------------------------------------------------------
# Frontend (Angular) — usada apenas no build de produção
# (`npm run build:producao`, comando de build da Vercel).
# Em desenvolvimento a URL vem de src/environments/environment.ts.
# ---------------------------------------------------------------

# URL pública do backend, sem barra no final e sem /api
API_URL=https://chamados-backend.onrender.com
